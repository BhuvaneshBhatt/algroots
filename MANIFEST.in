include CITATION.cff LICENSE README.md
recursive-include docs *.md
recursive-include examples *.py *.md *.json
recursive-include benchmarks *.py *.md *.json *.txt
recursive-include tests *.py
recursive-include tools *.py *.json
recursive-include ci *.txt *.toml *.json
recursive-exclude * __pycache__ *.py[cod] .DS_Store
prune .pytest_cache
prune .ruff_cache
prune build
prune dist
recursive-include src/algroots *.c *.cpp *.h *.inc
recursive-include licenses *.txt *.md

recursive-include licenses *.json
recursive-include .github *.yml *.yaml

include .clang-format
