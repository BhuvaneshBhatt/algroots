--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,6 +1,6 @@
 [build-system]
-requires = ["hatchling>=1.27"]
-build-backend = "hatchling.build"
+requires = ["setuptools>=77"]
+build-backend = "setuptools.build_meta"
 
 [project]
 name = "algroots"
@@ -68,8 +68,12 @@
     "mutmut>=3",
 ]
 
-[tool.hatch.build.targets.wheel]
-packages = ["src/algroots"]
+[tool.setuptools]
+package-dir = {"" = "src"}
+
+[tool.setuptools.packages.find]
+where = ["src"]
+include = ["algroots*"]
 
 [tool.pytest.ini_options]
 testpaths = ["tests"]
--- /dev/null
+++ b/MANIFEST.in
@@ -0,0 +1,11 @@
+include CHANGELOG.md CITATION.cff CONTRIBUTING.md LICENSE README.md
+recursive-include docs *.md
+recursive-include examples *.py *.md *.json
+recursive-include benchmarks *.py *.md *.json *.txt
+recursive-include tests *.py
+recursive-include tools *.py
+recursive-exclude * __pycache__ *.py[cod] .DS_Store
+prune .pytest_cache
+prune .ruff_cache
+prune build
+prune dist
